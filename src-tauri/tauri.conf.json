{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.tauri-app.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { 
        "title": "tauri-app",
        "width": 960,
        "height": 670,
        "decorations":true, 
        "resizable": true,
        "titleBarStyle": "Overlay",
        "shadow": true,
        "hiddenTitle": true,
        "windowClassname": "tauri-app",
        "transparent": true, 
        "devtools": true,
        "backgroundColor": {
          "red": 0,
          "green": 0,
          "blue": 0,
          "alpha": 0
        },
        "trafficLightPosition": {
          "x": 20,
          "y": 20
        },
        "windowEffects":{
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
